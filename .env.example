# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://venue:venue_dev_pw@localhost:5432/venue_booking
GROQ_API_KEY=gsk_...
GROQ_AGENT_MODEL=<large model id from the Groq console>
GROQ_EXTRACT_MODEL=<small model id from the Groq console>
GOOGLE_OAUTH_CLIENT_FILE=secrets/google_oauth_client.json
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
DRIVE_ROOT_FOLDER_ID=<Drive folder id>
ADMIN_EMAIL=<admin gmail address>
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Sign-in. GOOGLE_CLIENT_ID is the "Client ID" of the OAuth web client (also in the client JSON).
GOOGLE_CLIENT_ID=<...>.apps.googleusercontent.com
SESSION_SECRET=<a long random string>
# DEV_LOGIN=true lets you sign in by email alone. Local testing only, never on a shared machine.
DEV_LOGIN=false
